{
  "name": "agent-harness-engineering-handbook-ko-production-labs",
  "version": "0.1.0",
  "private": true,
  "description": "Executable weekly labs for Agent Harness Engineering Handbook KO",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "weeks/*"
  ],
  "scripts": {
    "verify:repo": "node scripts/validate-repository.mjs",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "verify:week1": "npm run verify --workspace=@handbook/week-01-foundations",
    "verify:week2": "npm run verify --workspace=@handbook/week-02-loop-engineering",
    "verify:week3": "npm run verify --workspace=@handbook/week-03-production-service",
    "verify": "npm run verify:repo && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
