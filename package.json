{
  "name": "agent-harness-engineering-handbook-ko-production-labs",
  "version": "0.1.0",
  "private": true,
  "description": "Executable weekly labs for Agent Harness Engineering Handbook KO",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "weeks/*",
    "optional/*"
  ],
  "scripts": {
    "verify:repo": "node scripts/validate-repository.mjs",
    "verify:publication": "node scripts/validate-repository.mjs && node scripts/validate-publication-boundary.mjs && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "e2e": "npm run test:e2e --workspaces --if-present",
    "verify:week1": "npm run verify --workspace=@handbook/week-01-foundations",
    "verify:week2": "npm run verify --workspace=@handbook/week-02-loop-engineering",
    "verify:week3": "npm run verify --workspace=@handbook/week-03-multi-agent",
    "verify:web": "npm run verify --workspace=@handbook/optional-web-service-extension",
    "verify": "npm run verify:publication && npm run e2e"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "prettier": "3.7.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
